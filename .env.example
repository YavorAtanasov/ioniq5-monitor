# --- Bluelink / Kia Connect account ---
BLUELINK_USERNAME=you@example.com
BLUELINK_PASSWORD=hunter2
BLUELINK_PIN=1234
BLUELINK_BRAND=hyundai        # hyundai | kia
BLUELINK_REGION=EU            # US | EU | CA
BLUELINK_VIN=YOUR_VIN_HERE
BLUELINK_LANGUAGE=en

# --- Polling behaviour ---
# How often to poll live vehicle status (minutes). Keep this generous -
# every poll can wake the car and drain the 12V battery if it forces a live refresh.
STATUS_POLL_MINUTES=60
# How often to check for new trips / daily energy report (minutes). This uses
# cached server-side data, so it's cheap and can run more often.
TRIP_POLL_MINUTES=30
# How often to pull the daily energy breakdown (kWh consumed/regenerated).
# This forces a live refresh of the car (unlike status/trips, which use
# cached data) so keep it infrequent - a few times a day is plenty.
ENERGY_POLL_MINUTES=240

# --- InfluxDB (must match docker-compose.yml) ---
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=ioniq5
INFLUX_BUCKET=vehicle
INFLUX_TOKEN=my-super-secret-admin-token

# --- Hosted dashboard (optional) ---
# Leave these unset for a purely self-hosted setup. When set, the poller also
# forwards readings to the hosted API - only readings, never your Bluelink
# credentials, which stay in this file on this machine. Both are normally
# written for you by `python poller/enroll.py --url ... --code ...`.
#CLOUD_INGEST_URL=https://cloud.example.com
#CLOUD_AGENT_KEY=ioniq5_ak_...
# Which destinations to write to. Defaults to whichever of the two above are
# configured, so existing setups need no change.
#SINKS=influx,cloud

# --- Admin creds used by docker-compose ---
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=changeme123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme123
