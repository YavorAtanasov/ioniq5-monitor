# Cloud API configuration. Every variable is prefixed CLOUD_.
CLOUD_DATABASE_URL=postgresql+psycopg://ioniq5:ioniq5@postgres:5432/ioniq5

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUD_JWT_SECRET=change-me
CLOUD_API_KEY_PEPPER=change-me

CLOUD_JWT_TTL_MINUTES=720
CLOUD_ENROLLMENT_CODE_TTL_MINUTES=60

# Postgres container credentials
POSTGRES_USER=ioniq5
POSTGRES_PASSWORD=ioniq5
POSTGRES_DB=ioniq5
